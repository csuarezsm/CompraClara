# Copia este archivo a .env y rellena con valores aleatorios largos:
#   openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=
CONTRIB_SECRET=
# Clave del panel /admin (duplicados de supermercados), mínimo 24 caracteres
ADMIN_TOKEN=
# Puerto local (solo 127.0.0.1). Cámbialo si ya está ocupado en el servidor.
API_PORT=8095
